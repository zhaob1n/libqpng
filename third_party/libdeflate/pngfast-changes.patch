+/* png-next: like libdeflate_deflate_decompress_ex(), but calls cb(ctx, out_next) roughly every 'step' output
+ * bytes. Bytes below out_next - 32768 are no longer referenced by the decoder, so the callback may rewrite them. */
+LIBDEFLATEAPI enum libdeflate_result
+libdeflate_deflate_decompress_progress(struct libdeflate_decompressor *d,
+				       const void *in, size_t in_nbytes,
+				       void *out, size_t out_nbytes_avail,
+				       size_t *actual_in_nbytes_ret,
+				       size_t *actual_out_nbytes_ret,
+				       void (*cb)(void *ctx, const u8 *out_next),
+				       void *ctx, size_t step)
+{
+	enum libdeflate_result r;
+	d->progress_cb = cb; d->progress_ctx = ctx; d->progress_step = step ? step : 1;
+	r = decompress_impl(d, in, in_nbytes, out, out_nbytes_avail,
+			    actual_in_nbytes_ret, actual_out_nbytes_ret);
+	d->progress_cb = NULL;
+	return r;
+}
