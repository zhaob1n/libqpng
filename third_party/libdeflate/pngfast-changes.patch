+/* png-fast tuning knobs (block length 5000..300000, skip shift 1..31; 0 = keep) */
+LIBDEFLATEAPI void
+libdeflate_set_png_params(struct libdeflate_compressor *c, unsigned block_len,
+			  unsigned skip_shift)
+{
+	if (block_len)
+		c->png_block_len = MAX(MIN_BLOCK_LENGTH, MIN(block_len, SOFT_MAX_BLOCK_LENGTH));
+	if (skip_shift)
+		c->png_skip_shift = MIN(skip_shift, 31);
+}
+
+LIBDEFLATEAPI void
+libdeflate_set_png_min_match(struct libdeflate_compressor *c, unsigned min_len)
+{
+	if (c->impl == deflate_compress_png_fast && min_len >= 4 && min_len <= 8)
+		c->png_min_hash_len = min_len;
+}
